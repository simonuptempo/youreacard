ios.release = "res://addons/native_photos/bin/libnative_photos.ios.template_release.xcframework"
macos.debug = "res://addons/native_photos/bin/libnative_photos.macos.template_debug.dylib"
macos.release = "res://addons/native_photos/bin/libnative_photos.macos.template_release.dylib"
