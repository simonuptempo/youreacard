#!/usr/bin/env python
# Builds the native photo add-on. Run from this folder after cloning godot-cpp here:
#   scons platform=ios arch=arm64 target=template_release
env = SConscript("godot-cpp/SConstruct")
env.Append(CPPPATH=["src/"])

# iPhone gets a static library; the Mac editor gets a shared one (.dylib).
make = env.Object if env["platform"] == "ios" else env.SharedObject
objects = [make(s) for s in Glob("src/*.cpp")]
objc_flags = env["CCFLAGS"] + ["-fobjc-arc"]
objects += [make(s, CCFLAGS=objc_flags) for s in Glob("src/*.mm")]

if env["platform"] == "ios":
    # A static library; the build script merges it with godot-cpp into an xcframework.
    lib = env.StaticLibrary("build/libnative_photos.ios.{}.a".format(env["target"]), source=objects)
else:
    lib = env.SharedLibrary("bin/libnative_photos.{}.{}{}".format(env["platform"], env["target"], env["SHLIBSUFFIX"]), source=objects)
Default(lib)
